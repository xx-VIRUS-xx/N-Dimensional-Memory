{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nd/event.schema.json",
  "title": "N-D event (event-star shape) v0",
  "type": "object",
  "required": ["tick", "source", "kind", "roles", "status"],
  "additionalProperties": false,
  "properties": {
    "tick": {"type": "integer", "minimum": 0, "description": "Unique per event, assigned by the engine at commit; never shared."},
    "source": {
      "type": "object",
      "required": ["sentence_id"],
      "additionalProperties": false,
      "properties": {
        "sentence_id": {"type": "string"},
        "speaker": {"type": ["string", "null"], "description": "Peg of whoever asserted this; null = narrator."}
      }
    },
    "kind": {"type": "string", "description": "From catalog/kinds."},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 6,
      "description": "Dimension name (from catalog) -> filler. Direction lives in the role name.",
      "additionalProperties": {"$ref": "#/$defs/filler"}
    },
    "occurred": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string"}, "from": {"type": ["string", "null"]}, "to": {"type": ["string", "null"]}
      }
    },
    "status": {
      "type": "object",
      "required": ["type", "owner"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["fact", "claim", "speaker_belief", "model_belief", "open_question", "intent"]},
        "owner": {"type": ["string", "null"], "description": "Peg that owns the status; null = narrator (facts)."},
        "polarity": {"enum": ["pos", "neg"], "default": "pos"},
        "modality": {"enum": ["certain", "probable", "possible", "hypothetical"], "default": "certain"}
      }
    },
    "recurrence_of": {"type": ["integer", "null"], "description": "Tick of an earlier event this repeats (stated, e.g. 'again')."}
  },
  "$defs": {
    "filler": {
      "oneOf": [
        {"type": "object", "required": ["peg"], "additionalProperties": false, "properties": {"peg": {"type": "string"}}},
        {"type": "object", "required": ["pegs"], "additionalProperties": false, "properties": {"pegs": {"type": "array", "items": {"type": "string"}, "minItems": 2}}},
        {"type": "object", "required": ["lit"], "additionalProperties": false, "properties": {"lit": {"type": "string", "maxLength": 40}}},
        {"type": "object", "required": ["event"], "additionalProperties": false, "properties": {"event": {"type": "integer"}}},
        {"type": "object", "required": ["bucket"], "additionalProperties": false,
         "properties": {"bucket": {"type": "object", "required": ["query", "candidates"], "additionalProperties": false,
           "properties": {"query": {"type": "string"}, "candidates": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "integer"}]}, "minItems": 1},
                          "model_belief": {"oneOf": [{"type": "string"}, {"type": "integer"}, {"type": "null"}]}}}}}
      ]
    }
  }
}
