# ============================================================
# Persistent Memory Benchmark - V7.7.1
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pytype/
.pyre/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ---------- Secrets ----------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
**/secrets/
**/credentials/

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- Logs ----------
*.log
logs/
**/logs/

# ---------- Generated benchmark results ----------
results/*
!results/.gitkeep

# ---------- Agent-generated memories ----------
memory/frozen/*
!memory/frozen/.gitkeep
**/*.memory.json
**/*.MEMORY.json
**/*memory*.json

# ---------- Agent outputs ----------
agents/*/results/
agents/*/outputs/
agents/*/artifacts/
agents/*/workspace/

# ---------- Retrieval indexes ----------
**/indexes/
**/index/
**/vector_store/
**/vectordb/
**/chroma/
**/faiss/
**/embeddings/
**/.cache/

# ---------- Graph databases ----------
docker/graphiti/data/
docker/graphiti/neo4j/
docker/graphiti/logs/
docker/graphiti/backups/
neo4j_data/
falkordb_data/

# ---------- Generated competitor artifacts ----------
competitors/*/data/
competitors/*/index/
competitors/*/indexes/
competitors/*/output/
competitors/*/outputs/
competitors/*/cache/

# ---------- Model/cache directories ----------
huggingface/
.huggingface/
transformers_cache/
torch_cache/
model_cache/
models/

# ---------- Local datasets ----------
# Keep dataset schemas and documentation tracked.
# Keep actual large/generated datasets local unless explicitly approved.
benchmark/datasets/*/generated/
benchmark/datasets/*/cache/
benchmark/datasets/*/processed/

# ---------- Evaluator material ----------
# Gold data should NOT accidentally enter agent environments or commits.
benchmark/evaluator/
benchmark/gold/
**/evaluator_gold/
**/gold_private/
**/*gold*.private.*
**/*gold*.secret.*

# ---------- Experiment archives ----------
*.zip
*.tar
*.tar.gz
*.7z

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.bak
*.old

# ---------- Database files ----------
*.db
*.sqlite
*.sqlite3

# ---------- Docker ----------
docker/*/.env
docker/*/data/
docker/*/volumes/

# ---------- Node / frontend tooling if added later ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
dist/
build/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ============================================================
# IMPORTANT TRACKED FILES
# ============================================================
# Keep:
# README.md
# AGENT_SETUP_PROMPT.md
# RUN_AGENT.md
# RUN_RETRIEVAL.md
# RUN_EVALUATION.md
# benchmark/schemas/
# benchmark/validation/
# scripts/
# competitors/*/adapter.py
# competitors/*/runner.py
# competitors/*/README.md
# docker/graphiti/docker-compose.yml
# docker/graphiti/.env.example
# agents/antigravity/README.md
#
# Do NOT commit:
# real API keys
# frozen private evaluator gold
# generated memories
# retrieval indexes
# graph databases
# raw model caches
# experimental result dumps
# ============================================================